generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  rut           String   @unique
  nombre        String
  rol           String
  email         String   @unique
  password_hash String
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  historialesAutorizados HistorialReasignacion[] @relation("UsuarioAutoriza")
}

model Trabajador {
  id                    String  @id @default(uuid())
  rut                   String  @unique
  nombre                String
  apellido              String
  cargo                 String
  estado_disponibilidad String  @default("DISPONIBLE")
  ultimo_descanso_horas Int     @default(16)
  activo                Boolean @default(true)

  turnos                  Turno[]
  predicciones            PrediccionFatiga[]
  reasignacionesOrigen    HistorialReasignacion[] @relation("OrigenReasignacion")
  reasignacionesReemplazo HistorialReasignacion[] @relation("ReemplazoReasignacion")
}

model Turno {
  id                       Int        @id @default(autoincrement())
  trabajadorId             String
  trabajador               Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  tipo_turno               String
  fecha_inicio             DateTime   @default(now())
  fecha_fin                DateTime
  horas_acumuladas_semana  Int        @default(45)
  descansos_compensatorios Int        @default(2)
  noches_consecutivas      Int        @default(0)
  estado_turno             String     @default("ACTIVO")
}

model PrediccionFatiga {
  id                Int        @id @default(autoincrement())
  trabajadorId      String
  trabajador        Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  fecha_calculo     DateTime   @default(now())
  riesgo_porcentaje Int
  nivel_riesgo      String
  peso_horas        Int
  peso_noches       Int
  peso_descanso     Int
  factor_critico    String
}

model HistorialReasignacion {
  id                    Int         @id @default(autoincrement())
  fecha                 String
  trabajadorOrigenId    String
  trabajadorOrigen      Trabajador  @relation("OrigenReasignacion", fields: [trabajadorOrigenId], references: [id], onDelete: Cascade)
  trabajadorReemplazoId String?
  trabajadorReemplazo   Trabajador? @relation("ReemplazoReasignacion", fields: [trabajadorReemplazoId], references: [id], onDelete: SetNull)
  usuarioId             Int
  usuario               Usuario     @relation("UsuarioAutoriza", fields: [usuarioId], references: [id], onDelete: Restrict)
  accion                String
  motivo                String
  creadoEn              DateTime    @default(now())
}