# Credenciales del contenedor PostgreSQL en Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=safeshift
POSTGRES_DB=safeshift_db

# Cadena de conexión para Prisma ORM
DATABASE_URL="postgresql://admin:safeshift@localhost:5432/safeshift_db?schema=public"

# Puerto del servidor Backend (distinto al 3000 del Frontend)
PORT=4000